{
  "name": "pixivflow",
  "version": "2.10.28",
  "description": "🎨 智能的 Pixiv 自动化下载工具 - 支持批量下载插画和小说、定时任务、Docker部署 | Intelligent Pixiv Automation Downloader with batch download, scheduler, and Docker support",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redtidev1918/PixivFlow.git"
  },
  "homepage": "https://redtidev1918.github.io/PixivFlow/",
  "bugs": {
    "url": "https://github.com/redtidev1918/PixivFlow/issues"
  },
  "author": "redtidev1918",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "pixivflow": "dist/index.js"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc && node scripts/create-webui-package-json.js",
    "build:watch": "tsc --watch",
    "start": "npm run build && node dist/index.js",
    "login": "./scripts/login.sh",
    "login:headless": "npm run build && node dist/index.js login-headless",
    "refresh": "npm run build && node dist/index.js refresh",
    "download": "npm run build && node dist/index.js download",
    "scheduler": "npm run build && node dist/index.js scheduler",
    "test": "jest --runInBand",
    "test:scheduled": "jest --runTestsByPath src/__tests__/integration/download-flow.test.ts",
    "test:concurrency": "jest --runTestsByPath src/__tests__/utils/concurrency.test.ts",
    "test:performance": "jest --runInBand src/__tests__/performance",
    "benchmark": "npm run test:performance",
    "analyze:complexity": "node scripts/analyze-complexity.js",
    "analyze:unused": "npx ts-prune",
    "analyze:quality": "npm run analyze:complexity && npm run analyze:unused",
    "setup": "npm run build && node dist/setup-wizard.js",
    "random": "npm run build && node dist/index.js random",
    "clean": "rm -rf dist",
    "pixiv": "./scripts/pixiv.sh",
    "pixiv:setup": "./scripts/pixiv.sh setup",
    "pixiv:run": "./scripts/pixiv.sh run",
    "pixiv:once": "./scripts/pixiv.sh once",
    "pixiv:test": "./scripts/pixiv.sh test",
    "pixiv:status": "./scripts/pixiv.sh status",
    "pixiv:health": "./scripts/pixiv.sh health",
    "config": "npm run build && node dist/index.js config",
    "health": "npm run build && node dist/index.js health",
    "monitor": "npm run build && node dist/index.js monitor",
    "maintain": "npm run build && node dist/index.js maintain",
    "backup": "npm run build && node dist/index.js backup",
    "standalone:build": "npm run build",
    "standalone:setup": "npm run setup",
    "standalone:run": "npm run scheduler",
    "standalone:run-once": "npm run download",
    "test:download": "npm run test",
    "webui": "npm run build && node dist/webui/index.js",
    "webui:dev": "npm run build:watch & npm run webui",
    "webui:frontend": "cd webui-frontend && npm run dev",
    "webui:build": "cd webui-frontend && npm run build",
    "dev:kill": "npx kill-port 3000 5173",
    "dev:backend": "cross-env PORT=3000 nodemon --watch dist dist/webui/index.js",
    "dev:frontend": "cross-env VITE_DEV_API_PORT=3000 npm run webui:frontend",
    "dev": "npm run build && npx kill-port 3000 5173 && concurrently -n \"backend-build,backend,frontend\" -c \"yellow,blue,green\" \"npm run build:watch\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "webui:start": "npm run webui:build && npm run webui",
    "webui:dev:full": "npm run build && concurrently -n \"backend-build,backend,frontend\" -c \"yellow,blue,green\" \"npm run build:watch\" \"nodemon --watch dist dist/webui/index.js\" \"npm run webui:frontend\"",
    "publish:patch": "./scripts/publish.sh patch",
    "publish:minor": "./scripts/publish.sh minor",
    "publish:major": "./scripts/publish.sh major",
    "release": "./scripts/create-release.sh",
    "release:create": "./scripts/create-release.sh",
    "check:version": "./scripts/check-version-sync.sh",
    "versions:list": "./scripts/manage-versions.sh list",
    "versions:deprecate": "./scripts/manage-versions.sh deprecate",
    "versions:deprecate-old": "./scripts/manage-versions.sh deprecate-old",
    "versions:deprecate-all-but-latest": "./scripts/manage-versions.sh deprecate-old 1",
    "versions:unpublish": "./scripts/manage-versions.sh unpublish",
    "versions:unpublish-old": "./scripts/manage-versions.sh unpublish-old",
    "versions:unpublish-all-but-latest": "./scripts/manage-versions.sh unpublish-old 1",
    "tags:cleanup": "./scripts/cleanup-github-tags.sh",
    "tags:cleanup:dry-run": "./scripts/cleanup-github-tags.sh --dry-run"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.20.1",
    "@types/node-cron": "^3.0.11",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "kill-port": "^2.0.1",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "puppeteer": "^24.43.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.6.2"
  },
  "overrides": {
    "glob": "^10.3.10",
    "basic-ftp": "^5.2.0",
    "engine.io": "^6.6.7",
    "ip-address": "^10.7.0",
    "js-yaml": "^4.3.1",
    "path-to-regexp": "^0.1.13",
    "socket.io-adapter": "^2.5.8",
    "socket.io-parser": "^4.2.7",
    "ws": "^8.21.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "cron-parser": "^4.9.0",
    "express": "^4.22.2",
    "franc-min": "^6.2.0",
    "https-proxy-agent": "^7.0.6",
    "node-cron": "^4.6.0",
    "pixiv-token-getter": "^2.2.1",
    "socket.io": "^4.8.3",
    "socks-proxy-agent": "^8.0.5",
    "undici": "^6.28.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.0.0"
  },
  "files": [
    "dist/",
    "config/standalone.config.example.json",
    "config/fly-two-bots.example.json",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
